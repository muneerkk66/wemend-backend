# Copy to .env (gitignored) and fill in the two blanks.
# Team ID and Client ID are NOT secrets. The .p8 is — keep it out of the repo.

DATABASE_URL=postgresql+asyncpg://localhost/wemend_dev

APPLE_TEAM_ID=Y89LU2A58Y
APPLE_CLIENT_ID=com.necsca.wemendai

# From the Keys page after creating the Sign in with Apple key (10 chars).
APPLE_KEY_ID=

# Path to the downloaded .p8. Keep it OUTSIDE the repo — it downloads once and
# cannot be re-downloaded. Alternative: APPLE_PRIVATE_KEY_PEM with the contents.
APPLE_PRIVATE_KEY_PATH=/Users/muneerkk/.wemendai/AuthKey_XXXXXXXXXX.p8

# Voice plane (the GPU pod). Changes when the pod is recreated.
VOICE_BASE_URL=https://tg902v9mwkzxd6-8888.proxy.runpod.net
